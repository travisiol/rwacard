# Canonical origin. Used for metadataBase and the OG/Twitter tags.
NEXT_PUBLIC_SITE_URL=https://rwacard.site

# The brand's X account. The footer handle is derived from this URL, so the
# two can never disagree.
NEXT_PUBLIC_X_URL=https://x.com/RWACard

# Where every "Get a Card" points. The card app is not part of this repo;
# unset, the buttons expect a /get-card route to be added here.
NEXT_PUBLIC_CTA_HREF=/get-card

# Optional CDN origin for public/media (~35 MB of it is video). Must mirror
# the same /media/... keys. Unset, the files are served from this app.
# NEXT_PUBLIC_MEDIA_BASE=https://cdn.example.com
